<root BTCPP_format="4" main_tree_to_execute="MainTree">
    <BehaviorTree ID="MainTree">
        
        <KeepRunningUntilFailure>
            <Sequence name="CommandLoop">
                
                <!-- 等待手動輸入指令 (例如透過終端機發送 /mission_command "mode2") -->
                <WaitForTopic topic_name="/mission_command" command_out="{cmd}" />

                <Fallback name="StageSelector">
                    
                    <!-- ================================================== -->
                    <!-- 模式一：純導航與建立地圖 (SLAM)                      -->
                    <!-- ================================================== -->
                    <Sequence name="Mode_1_Mapping">
                        <ScriptCondition code=" cmd == 'mode1' " />
                        <ExecuteScript action="print('啟動模式一：開啟 SLAM 建圖並進行多點導航')" />
                        
                        <!-- 啟動 SLAM 的腳本 (或者假設 SLAM 已在背景開啟) -->
                        <ExecuteScript action="start_slam" />
                        
                        <!-- 依序發送固定座標 -->
                        <NavigateToPose pose="WAYPOINT_A" /> 
                        <NavigateToPose pose="WAYPOINT_B" /> 
                        <NavigateToPose pose="WAYPOINT_C" /> 
                    </Sequence>

                    <!-- ================================================== -->
                    <!-- 模式二：全自動巡邏、動態辨識、座標過濾與自動夾取迴圈     -->
                    <!-- ================================================== -->
                    <Sequence name="Mode_2_AutoDollCollection">
                        <ScriptCondition code=" cmd == 'mode2' " />
                        <ExecuteScript action="print('啟動模式二：全自動巡邏與夾取任務')" />
                        
                        <KeepRunningUntilFailure>
                            <ForceSuccess> <ReactiveFallback name="Patrol_and_Interrupt">
                                    
                                    <Sequence name="HandleValidDoll">
                                        
                                        <FindValidDoll target_pose="{target_pose}" />
                                        
                                        <NavigateToPose pose="{target_pose}" />
                                        
                                        <DockRobot target_item="doll" />
                                        
                                        <RetryUntilSuccessful num_attempts="-1">
                                            <Sequence>
                                                <ExecuteScript action="grab" />
                                                <CheckCamera status="check_height" /> 
                                            </Sequence>
                                        </RetryUntilSuccessful>

                                        <NavigateToPose pose="HOME" />
                                        <ExecuteScript action="drop" />
                                    </Sequence>

                                    <KeepRunningUntilFailure>
                                        <ForceSuccess> <Sequence name="Patrol">
                                                <NavigateToPose pose="WAYPOINT_A" />
                                                <NavigateToPose pose="WAYPOINT_B" />
                                                <NavigateToPose pose="WAYPOINT_C" />
                                                <NavigateToPose pose="WAYPOINT_D" />
                                            </Sequence>
                                        </ForceSuccess>
                                    </KeepRunningUntilFailure>

                                </ReactiveFallback>
                                
                            </ForceSuccess>
                        </KeepRunningUntilFailure>
                    </Sequence>

                    <!-- ================================================== -->
                    <!-- 模式三：過橋任務                                     -->
                    <!-- ================================================== -->
                    <Sequence name="Mode_3_CrossBridge">
                        <ScriptCondition code=" cmd == 'mode3' " />
                        <ExecuteScript action="print('啟動模式三：執行過橋任務')" />
                        <NavigateToPose pose="BRIDGE_START_POSE" />
                        <NavigateToPose pose="BRIDGE_END_POSE" />
                        <NavigateToPose pose="HOME" />
                    </Sequence>

                    <!-- ================================================== -->
                    <!-- 模式四：橋上特殊娃娃夾取                               -->
                    <!-- ================================================== -->
                    <Sequence name="Mode_4_BridgeSpecialDoll">
                        <ScriptCondition code=" cmd == 'mode4' " />
                        <ExecuteScript action="print('啟動模式四：橋上特殊娃娃夾取任務')" />
                        <NavigateToPose pose="BRIDGE_START_POSE" />
                        <NavigateToPose pose="BRIDGE_CENTER_POSE" />
                        
                        <!-- 利用相機辨識並貼近特殊娃娃 -->
                        <DockRobot target_item="special_doll" />
                        <ExecuteScript action="grab_special" />
                        
                        <NavigateToPose pose="HOME" />
                        <ExecuteScript action="drop" />
                    </Sequence>

                    <!-- ================================================== -->
                    <!-- 模式五：開門任務                                     -->
                    <!-- ================================================== -->
                    <Sequence name="Mode_5_OpenDoor">
                        <ScriptCondition code=" cmd == 'mode5' " />
                        <ExecuteScript action="print('啟動模式五：開門任務')" />
                        <NavigateToPose pose="DOOR_FRONT_POSE" />
                        
                        <!-- 辨識門把並對齊 -->
                        <DockRobot target_item="door_handle" />
                        
                        <!-- 夾住門把並往下拉 -->
                        <ExecuteScript action="pull_handle_down" />
                        
                        <!-- 車子向前移動把門撞開 -->
                        <ExecuteScript action="push_door_forward" />
                    </Sequence>

                    <!-- 防呆機制：收到未知指令 -->
                    <Sequence name="UnknownCommand">
                        <ExecuteScript action="print('長官，我聽不懂這個指令！')" />
                        <AlwaysFailure />
                    </Sequence>

                </Fallback>
            </Sequence>
        </KeepRunningUntilFailure>

    </BehaviorTree>
</root>