<root BTCPP_format="4" main_tree_to_execute="MainTree">
    <BehaviorTree ID="MainTree">

        <Sequence name="Single_Doll_Collection_Task">

            <ReactiveFallback name="Patrol_and_Interrupt">

                <Sequence name="HandleValidDoll">
                    <FindValidDoll target_pose="{target_pose}" />

                    <VisualApproach />
                </Sequence>

                <KeepRunningUntilFailure>
                    <Sequence name="Patrol_Loop">

                        <GetNextWaypoint file_path="/workspaces/src/robot_behavior/config/patrol_points.yaml" output_pose="{patrol_pose}" />

                        <NavigateToPose pose="{patrol_pose}" />

                    </Sequence>
                </KeepRunningUntilFailure>

            </ReactiveFallback>

            <Sequence name="Grab_And_Go_Home">
                <ExecuteScript action="grab_doll" />
                
                <GetNextWaypoint file_path="/workspaces/src/robot_behavior/config/home_pose.yaml" output_pose="{home_pose}" />
                
                <NavigateToPose pose="{home_pose}" />
                
                <ExecuteScript action="drop_doll" />
            </Sequence>

        </Sequence>

    </BehaviorTree>
</root>
